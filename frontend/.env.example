# Appwrite Configuration
# Copy this file to .env and fill in your values

# Appwrite API Endpoint (e.g., https://api.edizo.in/v1)
APPWRITE_ENDPOINT=https://api.edizo.in/v1

# Appwrite Project ID (from Appwrite Console > Project Settings)
APPWRITE_PROJECT_ID=your_project_id_here

# Appwrite Database ID (from Appwrite Console > Databases)
APPWRITE_DATABASE_ID=Life_db

# Appwrite Storage Bucket ID for health images
APPWRITE_HEALTH_IMAGES_BUCKET=health-images

# Appwrite API Key (Server-side only! Do not include in Flutter app)
# This is only used for setup scripts, not the Flutter app
APPWRITE_API_KEY=your_api_key_here
